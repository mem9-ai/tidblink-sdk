  "paths": {
    "/api/v1/org/connectors": {
      "get": {
        "description": "Every Connector an Application Server declared on a Backend Connection with connector.serve, whether or not a connection serves it now.\n\nAuthorization: OrganizationApiKey; persisted credentials determine Organization scope; no End User scope. User API Keys do not read Connectors; Application Servers declare them on a Backend Connection with connector.serve.",
        "operationId": "ConnectorsController_list",
        "parameters": [],
        "responses": {
          "200": {
            "description": "Connectors.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "connectors"
                  ],
                  "additionalProperties": false,
                  "properties": {
                    "connectors": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "description": "A Connector declared on a Backend Connection with connector.serve. Its displayName is the declared Connector name; Templates reference it by connectorId as tools.mcp[].serverId.",
                        "required": [
                          "connectorId",
                          "displayName",
                          "createdAt",
                          "updatedAt"
                        ],
                        "additionalProperties": false,
                        "properties": {
                          "connectorId": {
                            "type": "string",
                            "pattern": "^conn_[a-f0-9-]{36}$"
                          },
                          "displayName": {
                            "type": "string"
                          },
                          "createdAt": {
                            "type": "string",
                            "format": "date-time"
                          },
                          "updatedAt": {
                            "type": "string",
                            "format": "date-time"
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "authentication_required: missing or invalid credentials.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          },
          "403": {
            "description": "auth_kind_forbidden: requires an Organization API Key.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          }
        },
        "security": [
          {
            "OrganizationApiKey": []
          }
        ],
        "summary": "List the Organization’s Connectors.",
        "tags": [
          "Connectors"
        ]
      }
    },
    "/api/v1/org/connectors/{connectorId}": {
      "get": {
        "operationId": "ConnectorsController_get",
        "parameters": [
          {
            "name": "connectorId",
            "required": true,
            "in": "path",
            "schema": {
              "type": "string",
              "pattern": "^conn_[a-f0-9-]{36}$"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Connector.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "description": "A Connector declared on a Backend Connection with connector.serve. Its displayName is the declared Connector name; Templates reference it by connectorId as tools.mcp[].serverId.",
                  "required": [
                    "connectorId",
                    "displayName",
                    "createdAt",
                    "updatedAt"
                  ],
                  "additionalProperties": false,
                  "properties": {
                    "connectorId": {
                      "type": "string",
                      "pattern": "^conn_[a-f0-9-]{36}$"
                    },
                    "displayName": {
                      "type": "string"
                    },
                    "createdAt": {
                      "type": "string",
                      "format": "date-time"
                    },
                    "updatedAt": {
                      "type": "string",
                      "format": "date-time"
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "authentication_required: missing or invalid credentials.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          },
          "403": {
            "description": "auth_kind_forbidden: requires an Organization API Key.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          },
          "404": {
            "description": "Connector not found.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          }
        },
        "security": [
          {
            "OrganizationApiKey": []
          }
        ],
        "summary": "Get one Connector.",
        "tags": [
          "Connectors"
        ],
        "description": "Authorization: OrganizationApiKey; persisted credentials determine Organization scope; no End User scope. User API Keys do not read Connectors; Application Servers declare them on a Backend Connection with connector.serve."
      }
    }
  },
